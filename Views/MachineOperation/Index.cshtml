@model IEnumerable<MakinaPeryodikBakimTakibi.Models.MachineOperation>
@{
    ViewData["Title"] = "Makina İşlemleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Makina İşlemleri</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni İşlem</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Kod</th>
            <th>İşlem Adı</th>
            <th>Tahmini Süre</th>
            <th>Periyodik</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.EstimatedMinutes dk</td>
                <td>@(item.IsPeriodic ? "Evet" : "Hayır")</td>
            </tr>
        }
    </tbody>
</table>
