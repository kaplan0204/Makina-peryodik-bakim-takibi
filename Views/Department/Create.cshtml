@model MakinaPeryodikBakimTakibi.Models.Department
@{
    ViewData["Title"] = "Bölüm Ekle";
}

<h2>Bölüm Ekle</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label">Bölüm Kodu</label>
        <input asp-for="Code" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Bölüm Adı</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ResponsiblePerson" class="form-label">Sorumlu</label>
        <input asp-for="ResponsiblePerson" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Aktif</label>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>
