<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Makina-peryodik-bakim-takibi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Makina-peryodik-bakim-takibi</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Department" asp-action="Index">Bölümler</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Machine" asp-action="Index">Makinalar</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Employee" asp-action="Index">Personeller</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="MachineOperation" asp-action="Index">Makina İşlemleri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="MaintenanceRecord" asp-action="Index">Bakım Fişleri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="PeriodicMaintenance" asp-action="Index">Periyodik Bakımlar</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
