@model MakinaPeryodikBakimTakibi.Models.Employee
@{
    ViewData["Title"] = "Personel Ekle";
    var departments = ViewBag.Departments as List<MakinaPeryodikBakimTakibi.Models.Department> ?? new();
}

<h2>Personel Ekle</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Code" class="form-label">Personel Kodu</label>
            <input asp-for="Code" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="EmployeeNumber" class="form-label">Sicil No</label>
            <input asp-for="EmployeeNumber" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label">Ad</label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Soyad</label>
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">Telefon</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">E-Mail</label>
            <input asp-for="Email" class="form-control" type="email" />
        </div>
        <div class="col-md-6">
            <label asp-for="Position" class="form-label">Görev</label>
            <input asp-for="Position" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="DepartmentId" class="form-label">Bölüm</label>
            <select asp-for="DepartmentId" class="form-select">
                <option value="0">Seçiniz</option>
                @foreach (var department in departments)
                {
                    <option value="@department.Id">@department.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="form-check my-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Aktif</label>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>
